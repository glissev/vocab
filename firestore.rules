rules_version = '2';

// Each signed-in user can read and write only their own data:
//   users/{uid}                 profile (languages, quiz settings)
//   users/{uid}/entries/{id}    vocabulary entries
// Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /entries/{entryId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.a is list
          && request.resource.data.b is list
          && request.resource.data.a.size() <= 20
          && request.resource.data.b.size() <= 20
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 1000;
      }
    }
  }
}
